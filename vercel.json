{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__route__=health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__route__=$1"
    }
  ]
}
